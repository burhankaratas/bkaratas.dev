# bkaratas.dev — yönetim paneli ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# Vercel'de: Project → Settings → Environment Variables.

# --- Cloudflare Turnstile (bot koruması) ---
# https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Panel oturumu ---
# Rastgele, en az 32 karakter:  openssl rand -hex 32
PANEL_SESSION_SECRET=

# --- Panel giriş bilgileri ---
# Kullanıcı adı (varsayılan: mbkaratas — tanımlamazsanız bu kullanılır)
# PANEL_USERNAME=mbkaratas

# Parola (birini seçin)
# Önerilen:  node scripts/hash-password.mjs "parolanız"
PANEL_PASSWORD_HASH=
# Basit alternatif (hash yoksa kullanılır):
# PANEL_PASSWORD=
